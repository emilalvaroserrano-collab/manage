# MTS public site: all login and portal routes stay on this host.
MTS_APP_URL=https://managetech.abitech.site

# NEW Zendesk account. All business records live here.
ZENDESK_SUBDOMAIN=managetechservices-16737
ZENDESK_OAUTH_CLIENT_ID=managetech
# Genuine Support OAuth confidential-client secret (NOT Sunshine Conversations key).
ZENDESK_OAUTH_CLIENT_SECRET=REPLACE_WITH_NEW_SUPPORT_OAUTH_SECRET
ZENDESK_OAUTH_SCOPE=read write

# Independent random >=32-character session encryption secret.
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTE_SECRET

# MTS-hosted sign-in: send one-time email codes. Required for both /admin and /user.
# A verified sender/domain in Resend is needed; no email vendor is built into Zendesk OAuth.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Manage Tech Services <login@your-verified-domain.com>

# Optional messaging integration; these are NOT Support API OAuth credentials.
ZENDESK_CONVERSATIONS_APP_ID=6b047fc7549137efd52ee1bf
ZENDESK_CONVERSATIONS_KEY_ID=app_6b0481abc274cc2d32588bfe
ZENDESK_CONVERSATIONS_KEY_SECRET=

# No ZENDESK_REDIRECT_URI: the OAuth client_credentials flow has no browser callback.
